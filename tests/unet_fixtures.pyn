# the tiny UNet and dataset every test file shares; conftest.py re-exports these
import pytest
import torch

from data import DataSplit, Digits
from model import UNet, UNetConfig
from train import TrainConfig


@pytest.fixture
def cfg() -> UNetConfig:
    # 3 levels: 28 -> 14 -> 7, as the real model
    return (in_channels=1, channels=(8, 16, 16), time_dim=32, groups=4)


@pytest.fixture
def model(cfg: UNetConfig) -> UNet:
    return UNet(cfg)


@pytest.fixture
def awake(cfg: UNetConfig) -> UNet:
    # zero-init layers make a fresh model output exactly 0, which hides whether
    # anything reaches the output; nudging every weight off its init wakes them
    m = UNet(cfg)
    with torch.no_grad():
        for p in m.parameters():
            p.add_(0.1 * torch.randn_like(p))
    return m


@pytest.fixture
def data() -> DataSplit:
    # 4 fixed random images, repeated: 64 train, 32 val. Val holds the same 4
    # images, so a model that learns train lowers val too
    patterns = torch.rand(4, 1, 28, 28) * 2 - 1  # [4, 1, 28, 28] in [-1, 1]
    labels = torch.arange(4)  # [4], which pattern

    def repeat(n: int) -> Digits:
        return (images=patterns.repeat(n, 1, 1, 1), labels=labels.repeat(n))

    return (train_data=repeat(16), val_data=repeat(8))


@pytest.fixture
def train_cfg() -> TrainConfig:
    # a short run on data's 4 repeated images, about a second on CPU
    return (
        batch_size=16,
        schedule=(warmup_steps=5, max_steps=60, max_lr=1e-2, min_lr=1e-3),
        weight_decay=0.1,
        grad_clip=1.0,
        eval_interval=20,
        eval_iters=5,
    )
