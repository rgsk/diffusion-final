# one training run's log, behind one small object. It goes to wandb, a .jsonl copy
# of what wandb gets, and a .log copy of what the terminal shows
import io
import json
import math
import sys
import time
import traceback
from pathlib import Path
from types import TracebackType
from typing import Any, Self, TextIO

import torch
import wandb

from paths import LOG_DIR

# what train records at each evaluation. grad_norm: the largest gradient norm,
# before clipping, over the steps since the last evaluation
type EvalRow = (
    step: int, lr: float, train_loss: float, val_loss: float, grad_norm: float
)


class Tee(io.TextIOBase):
    # stands in for sys.stdout, so each print goes to the terminal and to the file
    def __init__(self, terminal: TextIO, file: TextIO):
        self.terminal = terminal
        self.file = file

    def write(self, s: str) -> int:
        self.file.write(s)
        return self.terminal.write(s)

    def flush(self):
        self.terminal.flush()
        self.file.flush()


def skip_printing_again(printed: BaseException):
    # an exception nothing catches reaches sys.excepthook, which prints its
    # traceback; let it pass over the one finish() printed, and print any other
    original = sys.excepthook

    def hook(
        exc_type: type[BaseException], exc: BaseException, tb: TracebackType | None
    ):
        if exc is not printed:
            original(exc_type, exc, tb)

    sys.excepthook = hook


class Run:
    def __init__(
        self,
        name: str,
        config: dict[str, Any],
        *,
        project: str = "diffusion-final",
        online: bool = True,
        log_dir: Path = LOG_DIR,
    ):
        self.online = online
        self.name = f"{name}_{time.strftime('%Y-%m-%d_%H-%M-%S')}"
        log_dir.mkdir(parents=True, exist_ok=True)
        # what the terminal shows, from here until finish(); line buffered, so a
        # killed run keeps every line printed before it
        self.log_path = log_dir / f"{self.name}.log"
        self.log_file = self.log_path.open("w", buffering=1)
        self.terminal = sys.stdout
        sys.stdout = Tee(self.terminal, self.log_file)
        # readable with jq, no wandb sync needed
        self.path = log_dir / f"{self.name}.jsonl"
        self.write({"event": "config", **config})
        # silent in setup, not init, because init logs in, printing "Loaded
        # credentials", before it applies its own settings
        wandb.setup(settings=wandb.Settings(silent=True))
        # wandb writes its run folder to log_dir/wandb. online=False runs it
        # offline, not disabled, so the run is still recorded and `wandb sync`
        # can upload it later
        self.wandb_run = wandb.init(
            project=, name=self.name, config=, dir=log_dir,
            mode="online" if online else "offline",
        )
        # after init, because wandb's Logs tab records the console from init on
        print(self.name)
        print("  ".join(f"{k}={v}" for k, v in config.items()))  # any:ok
        if online:
            print(f"wandb: {self.wandb_run.url}")

    def write(self, line: dict[str, Any]):
        # NaN and inf as null, because Python's json would write NaN, which jq rejects
        clean = {
            k: None if isinstance(v, float) and not math.isfinite(v) else v
            for k, v in line.items()  # any:ok
        }
        with self.path.open("a") as f:
            f.write(json.dumps(clean) + "\n")

    def log(
        self,
        (step=, lr=, train_loss=, val_loss=, grad_norm=): EvalRow,
        *,
        elapsed_s: float,
    ):
        # namespaced names, so wandb groups loss/*, grad/*, time/* and memory/* into
        # sections. Not system/*, because that section charts only the metrics
        # wandb collects itself
        metrics: dict[str, float] = {
            "loss/train": train_loss,
            "loss/val": val_loss,
            "lr": lr,
            "grad/max_norm": grad_norm,
            "time/elapsed_s": elapsed_s,
        }
        if torch.cuda.is_available():
            # peak since the process started, not current, so it shows the largest batch
            peak_bytes = torch.cuda.max_memory_allocated()
            metrics["memory/gpu_peak_gb"] = peak_bytes / 1e9
        self.write({"event": "log", "step": step, **metrics})
        self.wandb_run.log(metrics, step=)

    def summary(self, **numbers: float):
        # one number each for the whole run, which the wandb runs table sorts on
        self.write({"event": "summary", **numbers})
        self.wandb_run.summary.update(numbers)

    def log_checkpoint(self, path: Path):
        # upload as a model artifact, online only, because offline would copy the file
        # into the run folder and upload it nowhere. finish() waits for the upload
        if self.online:
            artifact = wandb.Artifact(path.stem, type="model")
            artifact.add_file(str(path))
            self.wandb_run.log_artifact(artifact)

    def finish(self, *, error: BaseException | None = None):
        # exit codes as wandb's own exit hook sets them, 1 for an exception and 255
        # for Ctrl+C; anything but 0 marks the run failed in wandb
        if error is None:
            status, exit_code = "finished", 0
        elif isinstance(error, KeyboardInterrupt):
            status, exit_code = "interrupted", 255  # Ctrl+C
        else:
            status, exit_code = "failed", 1
        error_line = None
        traceback_text = None
        if error is not None:
            # the line a traceback ends with, e.g. "ValueError: loss is nan"
            error_line = traceback.format_exception_only(error)[0].strip()
            # printed here, so the terminal, the .log and wandb's Logs tab all get
            # it. Ctrl+C gets only its line, because where it landed says nothing
            if isinstance(error, KeyboardInterrupt):
                print(error_line)
            else:
                traceback_text = "".join(traceback.format_exception(error))
                print(traceback_text, end="")
            skip_printing_again(error)
        # the .log's last line says how the run ended; with no such line, the
        # process was killed before it could write one
        print(f"run {status}")
        self.write(
            {
                "event": "end",
                "status": status,
                "error": error_line,
                "traceback": traceback_text,
            }
        )
        # in the summary too, so the runs table can show them as columns
        self.wandb_run.summary.update({"status": status, "error": error_line})
        self.wandb_run.finish(exit_code=)
        sys.stdout = self.terminal
        self.log_file.close()

    def __enter__(self) -> Self:
        return self

    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        error: BaseException | None,
        tb: TracebackType | None,
    ):
        self.finish(error=)  # also on an exception, so wandb never hangs open
