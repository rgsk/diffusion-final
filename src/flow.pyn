# flow matching's straight path from data to noise, and the velocity along it.
#   x_t = (1 - t) * x0 + t * noise,   t in [0, 1], t = 0 is data, t = 1 is noise
# Its derivative in t is noise - x0, the same at every t, so the model's target
# (the velocity) is one fixed vector per sample. No schedule, nothing learned
import torch
from einops import rearrange
from torch import Tensor

# what one training step regresses: model(x_t, t) should predict target
type FlowBatch = (x_t: Tensor, t: Tensor, target: Tensor)


def sample_t(n: int, *, device: str | torch.device = "cpu") -> Tensor:
    # out: [n], uniform on [0, 1), continuous; every point on the path is trained
    return torch.rand(n, device=device)


def interpolate(x0: Tensor, noise: Tensor, t: Tensor) -> Tensor:
    # x0, noise: [B, C, H, W], t: [B]
    # out: [B, C, H, W], each image t[b] of the way from its x0 to its noise
    t = rearrange(t, "B -> B 1 1 1")  # broadcasts over the pixels
    return (1 - t) * x0 + t * noise


def velocity(x0: Tensor, noise: Tensor) -> Tensor:
    # x0, noise: [B, C, H, W]
    # out: [B, C, H, W], d x_t / dt, which takes no t because the path is straight
    return noise - x0


def flow_batch(x0: Tensor) -> FlowBatch:
    # x0: [B, C, H, W], clean images
    # out: x_t [B, C, H, W], t [B], target [B, C, H, W]
    # fresh noise and a fresh t per image, so each step sees new points on new paths
    noise = torch.randn_like(x0)  # [B, C, H, W]
    t = sample_t(len(x0), device=x0.device)  # [B]
    x_t = interpolate(x0, noise, t)  # [B, C, H, W]
    return (x_t=, t=, target=velocity(x0, noise))


if __name__ == "__main__":
    from data import load_mnist

    torch.manual_seed(1)
    (images=x0) = load_mnist(train=False)  # [10000, 1, 28, 28]
    noise = torch.randn_like(x0)

    # the path isn't variance preserving: x_t is a mix of two independent things,
    # so its spread dips mid-path below both ends
    for t in (0.0, 0.25, 0.5, 0.75, 1.0):
        x_t = interpolate(x0, noise, torch.full((len(x0),), t))
        print(f"t={t:.2f}  mean {x_t.mean():+.3f}  std {x_t.std():.3f}")

    # loss floors for reading a training curve. A model that outputs 0 scores
    # E[target^2]; one that outputs the per-pixel mean target, ignoring its
    # input, scores the target's per-pixel variance. A trained model must beat both
    target = velocity(x0, noise)  # [10000, 1, 28, 28]
    zero_loss = target.pow(2).mean()
    mean_loss = (target - target.mean(0)).pow(2).mean()
    print(f"loss if predicting 0: {zero_loss:.3f}  per-pixel mean: {mean_loss:.3f}")
